COFFE_DATABASE_PORT=8090
COFFE_GAME_PORT=8091
COFFE_WEB_PORT=5173
COFFE_TOOLS_PORT=5175

# Cria a conta de desenvolvimento apenas na primeira migração de um banco novo.
COFFE_DEV_SEED=true

# Caminhos opcionais para instalações fora do PATH.
# COFFE_GO=C:/Program Files/Go/bin/go.exe
# COFFE_NGROK=C:/tools/ngrok.exe

# Dados e chave são gerados localmente; não devem acompanhar o código fonte.
# COFFE_DATABASE_DIR=C:/coffe-data
# COFFE_GAME_SECRET_FILE=C:/coffe-data/game-secret

# Ative somente quando o acesso ao jogo usa HTTPS.
COFFE_SECURE_COOKIES=false
